<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clade.dashboard-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/turagasanthoshkumar/Clade-NSE-Skills/dashboard/run_dashboard.py</string>
        <string>8080</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/turagasanthoshkumar/Clade-NSE-Skills</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/turagasanthoshkumar/Clade-NSE-Skills/dashboard/logs/dashboard_server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/turagasanthoshkumar/Clade-NSE-Skills/dashboard/logs/dashboard_server.err.log</string>
    <!-- macOS launchd defaults the soft open-files limit to 256, far too low for a
         Python server (110+ mmap'd .so before any work) plus sqlite + sockets +
         yfinance's slowly-leaking tz cache. This was causing recurring Errno-24
         "Too many open files" crash-restarts. Raise the ceiling well clear of any
         slow creep; the daily restart resets it anyway. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>16384</integer>
    </dict>
</dict>
</plist>
